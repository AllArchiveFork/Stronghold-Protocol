# SPDX-License-Identifier: GPL-3.0-or-later
# Copy to monitoring.env (not committed) next to compose.monitoring.yaml. No secrets here: the Grafana admin password
# lives only in the file GRAFANA_ADMIN_PASSWORD_FILE names (owner 472, mode 0400; README.md §3).

# The public address Grafana is served under; Nginx maps /monitor/ to 127.0.0.1:3160 without rewriting the path.
GRAFANA_ROOT_URL=https://example.invalid/monitor/

# The cluster coordinator's health report with traffic counters, reached over the WireGuard tunnel. ?traffic=1 is
# answered only to a loopback / private-network client (server/http/routes.js).
MONITOR_HEALTHZ_URL=http://10.0.0.2:35400/healthz?traffic=1
# (placeholder address: use the coordinator's actual tunnel address)

# Host path of the Grafana admin password file (bind-mounted read-only into the Grafana container).
GRAFANA_ADMIN_PASSWORD_FILE=/etc/ark-monitor/grafana-admin-password

# Pinned images (README.md lists their digests). Change them together with a re-test.
NODE_IMAGE=node:24.22.0-alpine3.24
COLLECTOR_IMAGE=ark-monitor-collector:local
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
GRAFANA_IMAGE=grafana/grafana:13.2.4
